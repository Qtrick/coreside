{
  "name": "coreside",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coreside - an AI-native personal software environment",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ai-access": "vitest run src/lib/ai-access-disclosure.test.ts && cargo test --manifest-path src-tauri/Cargo.toml --lib ai::access_mode",
    "test:hosted-auth": "vitest run src/lib/hosted",
    "test:typescript-6": "tsc --version && npm run typecheck",
    "assurance:report": "node -e \"console.log('See docs/RELEASE_READINESS.md')\"",
    "test:watch": "vitest",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run doctor && npm run check:rust && npm run test:rust && npm run build:web",
    "verify:full": "npm run fmt:check && npm run clippy && npm run verify",
    "audit:partial-update": "node scripts/audit-partial-update.mjs",
    "audit:partial-update-final-gaps": "node scripts/audit-partial-update-final-gaps.mjs",
    "test:migrations": "cargo test --manifest-path src-tauri/Cargo.toml --lib db::migration_fixtures",
    "test:contracts": "npm run doctor",
    "test:preservation": "vitest run src/lib/preservation.test.ts",
    "test:patch-scheduler": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::patch_scheduler",
    "test:drafts": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::drafts",
    "test:navigation-continuity": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::app_routes",
    "test:context-ledger": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::context_ledger",
    "test:provider-conformance": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::provider_conformance",
    "test:hydration": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::continuity",
    "test:partial-update-parity": "vitest run src/lib/preservation.test.ts",
    "test:runtime-v2": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2",
    "audit:runtime-v2": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2",
    "test:operations": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::operations",
    "test:surfaces": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::patch",
    "test:events": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::events",
    "test:capability-packs": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::packs",
    "test:branching": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::branch",
    "test:replay": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::transactions",
    "test:inspector": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::",
    "test:queue": "cargo test --manifest-path src-tauri/Cargo.toml --lib runtime_v2::queue",
    "test:application-kernel": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel",
    "test:application-manifest": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::manifest",
    "test:generated-data": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::data",
    "test:change-compiler": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::compiler",
    "test:permissions": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::permissions",
    "test:packages": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::packages",
    "test:policy": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::policy",
    "test:recovery": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::recovery",
    "brand:generate": "python3 scripts/generate_branding_assets.py",
    "crawl4ai:setup": "node scripts/crawl4ai-setup.mjs",
    "crawl4ai:doctor": "node scripts/crawl4ai-doctor.mjs",
    "crawl4ai:smoke": "node scripts/crawl4ai-smoke.mjs",
    "crawl4ai:test": "node scripts/crawl4ai-test.mjs",
    "crawl4ai:clean": "node scripts/crawl4ai-clean.mjs",
    "crawl4ai:stats": "node scripts/crawl4ai-stats.mjs stats",
    "tauri": "tauri",
    "doctor": "node scripts/coreside-doctor.mjs",
    "test:registered-actions": "cargo test --manifest-path src-tauri/Cargo.toml --lib application_kernel::registered_actions",
    "e2e:build": "env -u CARGO_TARGET_DIR npx tauri build --debug --features e2e --config src-tauri/tauri.e2e.conf.json --no-bundle",
    "e2e": "node e2e/run.mjs",
    "e2e:desktop": "npm run e2e:build && npm run e2e",
    "e2e:ci": "npm run e2e:desktop",
    "release:evidence": "node scripts/release-evidence.mjs",
    "release:evidence:quick": "node scripts/release-evidence.mjs --quick",
    "package:scan": "node scripts/scan-packaged-contents.mjs",
    "test:layout-overflow": "node scripts/layout-overflow-audit.mjs",
    "test:responsive-layout": "vitest run src/lib/layout-mode.test.ts src/lib/tool-viewport.test.ts",
    "test:interface-transparency": "vitest run src/lib/interface-transparency.test.ts",
    "test:wallpaper-reset": "vitest run src/lib/wallpaper.test.ts src/lib/consumer-errors.test.ts",
    "test:wallpaper-compositing": "vitest run src/lib/interface-transparency.test.ts src/lib/wallpaper-compositing.test.ts",
    "test:window-orchestrator": "cargo test --manifest-path src-tauri/Cargo.toml --lib windows::orchestrator",
    "test:settings": "vitest run src/lib/settings-categories.test.ts",
    "test:consumer-polish": "npm run test:layout-overflow && npm run test:wallpaper-reset && npm run test:wallpaper-compositing && npm run test:responsive-layout && npm run test:settings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.28",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@wdio/cli": "9.30.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "webdriverio": "9.30.0"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0",
    "serialize-javascript": "7.0.7"
  }
}
