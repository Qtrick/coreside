# Dependencies
node_modules/

# Build outputs — never commit; regenerated by npm/cargo/tauri build.
# Consumer capabilities live in source (src/, src-tauri/src/, services/), not here.
dist/
dist-ssr/
target/
src-tauri/target/

# Python packaging leftovers (regenerated by pip install -e)
*.egg-info/

# Environment secrets — never commit real keys
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# MCP config may contain provider keys (e.g. Supabase)
mcp.json
.mcp.json
.cursor/mcp.json

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# Logs and caches
*.log
npm-debug.log*
.eslintcache
coverage/
.vite/
*.tsbuildinfo

# Reference extracts (do not commit large trees)
.reference/

# Crawl4AI local runtime (venv, browsers cache data)
services/crawl4ai/.venv/
services/crawl4ai/.crawler-data/
services/crawl4ai/**/__pycache__/
services/crawl4ai/**/.pytest_cache/
*.pyc

# Local fallback database directory
.coreside/

# Desktop E2E temp / local overrides
e2e/.artifacts/
reports/.artifacts/
e2e-results/
logs/

# Generated assurance outputs (regenerate; do not commit stale invents)
reports/release-evidence.json
reports/local-beta-readiness.json
reports/packaging-results.json
reports/e2e-results.json

# Test / temp
tmp/
*.tmp

# Intermediate actool output (final Assets.car is committed under icons/)
src-tauri/icons/adaptive-build/

