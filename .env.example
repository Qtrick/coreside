# Coreside AI configuration
# Copy this file to .env and paste your API key:
#   cp .env.example .env
#
# Precedence (deterministic):
#   1. Provider-neutral values (AI_*)
#   2. Aliases for the selected AI_PROVIDER (GEMINI_*, OPENAI_*, ANTHROPIC_*/CLAUDE_*)
#   3. Safe code defaults for non-secret values only
#
# Only Gemini is implemented today. OpenAI / Anthropic (Claude) adapters can be
# added later without changing how you store keys — set AI_PROVIDER and drop in
# the matching key below (or use AI_API_KEY for any provider).

# Provider id: gemini | openai | anthropic | mock
# (gemini is implemented; openai/anthropic are reserved for future adapters)
AI_PROVIDER=gemini

# Preferred: one key for whichever provider AI_PROVIDER selects
AI_API_KEY=

# Optional model override (provider-specific default used when empty)
AI_MODEL=

# Optional custom base URL (provider default used when empty)
AI_BASE_URL=

# Logging: trace | debug | info | warn | error
CORESIDE_LOG_LEVEL=info

# ── Provider-specific aliases ───────────────────────────────────────────────
# Used only when the matching AI_* value is empty.
# You can keep several keys in .env and switch with AI_PROVIDER.

# Google Gemini (implemented)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# OpenAI (adapter not implemented yet — key is loaded for future use)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Anthropic Claude (adapter not implemented yet — key is loaded for future use)
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_MODEL=
CLAUDE_MODEL=
ANTHROPIC_BASE_URL=
