# Coreside AI configuration
# Copy this file to .env and paste your API key:
#   cp .env.example .env
#
# Precedence (deterministic):
#   1. Aliases for the selected AI_PROVIDER
#      (GEMINI_*, OPENAI_*, ANTHROPIC_*/CLAUDE_*, OPENROUTER_*)
#   2. Provider-neutral values (AI_*)
#   3. Safe code defaults for non-secret values only
#
# Tip: keep several provider keys filled in. AI_PROVIDER chooses which alias is
# used first (so a Gemini key in AI_API_KEY will not override OPENROUTER_API_KEY
# when AI_PROVIDER=openrouter).

# Provider id: gemini | openai | anthropic | openrouter | mock
# (gemini and openrouter are implemented; openai/anthropic reserved)
AI_PROVIDER=openrouter

# Preferred: one key for whichever provider AI_PROVIDER selects
AI_API_KEY=

# Optional model override (provider-specific default used when empty)
AI_MODEL=

# Optional custom base URL (provider default used when empty)
AI_BASE_URL=

# Logging: trace | debug | info | warn | error
CORESIDE_LOG_LEVEL=info

# ── Provider-specific aliases ───────────────────────────────────────────────
# Used only when the matching AI_* value is empty.
# You can keep several keys in .env and switch with AI_PROVIDER.

# Google Gemini (implemented)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# OpenAI (adapter not implemented yet — key is loaded for future use)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Anthropic Claude (adapter not implemented yet — key is loaded for future use)
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_MODEL=
CLAUDE_MODEL=
ANTHROPIC_BASE_URL=

# OpenRouter (implemented — OpenAI-compatible)
# Default base URL when empty: https://openrouter.ai/api/v1
# Suggested models: google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=

# ── Coreside hosted services (Supabase) ─────────────────────────────────────
# Publishable values only — safe for the desktop client bundle.
# Never put service-role keys or provider secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Research (local Crawl4AI sidecar) needs no search API key for URL/domain crawls.
# Developers: npm run crawl4ai:setup
# Optional overrides:
# CORESIDE_CRAWLER_SERVICE_ROOT=
# CORESIDE_CRAWLER_DATA_ROOT=

# ── Stripe billing ──────────────────────────────────────────────────────────
# Used by Supabase Edge Functions (billing-checkout, billing-portal, stripe-webhook).
# Prefer a restricted key (rk_…) over a full secret key (sk_…). Never commit live keys.
# Publishable key is not required for hosted Checkout; webhook secret is created with the endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-only Price IDs for plan+interval checkout (never send from the desktop).
# Verified test catalog amounts: Personal $19.99/mo, $191.88/yr; Pro $49.99/mo, $491.88/yr.
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ── Linkup open-web search (default discovery) ──────────────────────────────
# Precedence: OS keyring account coreside.search.linkup → LINKUP_API_KEY → not configured.
# Never expose this value to Vite or store it in SQLite.
LINKUP_API_KEY=

# ── Exa open-web search (optional compatibility discovery) ──────────────────
# Precedence: OS keyring account coreside.search.exa → EXA_API_KEY → not configured.
# Never store the Exa key in SQLite. Do not use Exa Agent; Search API only.
EXA_API_KEY=
# Optional non-secret defaults (Settings / SQLite remain authoritative at runtime):
# EXA_DEFAULT_SEARCH_MODE=fast
# EXA_DEFAULT_RESULT_COUNT=5
# EXA_SEARCH_PROFILE=saver
# EXA_MONTHLY_BUDGET_USD=
# EXA_SOFT_LIMIT_PERCENT=75
# EXA_CRITICAL_LIMIT_PERCENT=90
# EXA_HARD_LIMIT_PERCENT=100
