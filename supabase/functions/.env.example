# Supabase Edge Function secrets (set in dashboard or `supabase secrets set`).
# Never commit real values.

CORESIDE_AI_PROVIDER=openai
CORESIDE_AI_PROVIDER_API_KEY=
CORESIDE_AI_DEFAULT_MODEL=
# Optional override; requires CORESIDE_AI_ALLOW_DEV_BASE_URL=1 (dev only).
# CORESIDE_AI_BASE_URL=
# CORESIDE_AI_ALLOW_DEV_BASE_URL=

EXA_API_KEY=
# Canonical deployed Supabase secret. LINKUP_SECRET_KEY is accepted only as a
# temporary compatibility fallback during an environment-name migration.
LINKUP_API_KEY=

# Injected automatically for deployed functions; required for local `supabase functions serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (Edge Functions billing-checkout, billing-portal, stripe-webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Server-side app origin used to build Stripe return URLs from logical destinations.
# CORESIDE_BILLING_APP_BASE_URL=http://localhost:1422
