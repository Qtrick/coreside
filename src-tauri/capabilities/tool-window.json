{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tool-window",
  "description": "Generated tool-* windows: scoped app commands only; no core:default, no backup/restore/credentials.",
  "windows": ["tool-*"],
  "permissions": [
    "coreside-tool-scoped",
    "coreside-tool-deny-sensitive",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus"
  ]
}
